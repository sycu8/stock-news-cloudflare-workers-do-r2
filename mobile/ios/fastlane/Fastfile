default_platform(:ios)

platform :ios do
  desc "Create App ID, distribution cert, and App Store profile for CI"
  lane :ci_signing do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APPSTORE_API_KEY_ID"),
      issuer_id: ENV.fetch("APPSTORE_ISSUER_ID"),
      key_filepath: ENV.fetch("APPSTORE_API_KEY_PATH"),
      duration: 1200,
      in_house: false
    )

    keychain_password = ENV.fetch("KEYCHAIN_PASSWORD")

    create_keychain(
      name: "ci_build_keychain",
      password: keychain_password,
      default_keychain: true,
      unlock: true,
      timeout: 3600
    )

    begin
      produce(
        api_key: api_key,
        app_identifier: "vn.orangecloud.stocknews",
        app_name: "Stock News",
        skip_itc: true,
        enable_services: {
          associated_domains: "on"
        }
      )
    rescue StandardError => e
      UI.important("App ID may already exist — continuing: #{e.message}")
    end

    cert(
      api_key: api_key,
      development: false,
      keychain_path: lane_context[SharedValues::KEYCHAIN_PATH],
      keychain_password: keychain_password
    )

    sigh(
      api_key: api_key,
      app_identifier: "vn.orangecloud.stocknews",
      readonly: false,
      force: true
    )
  end
end
