{
  "name": "vn-market-daily-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "check": "tsc --noEmit",
    "test:article": "tsc --outDir .tmp-test --noEmit false && node test/article-routing.test.mjs && node test/article-impact.test.mjs && node test/article-detail-ui.test.mjs && node test/telegram-article-link.test.mjs && node test/investor-intel.test.mjs && node test/live-poll.test.mjs && node test/telegram-prefs.test.mjs",
    "predeploy": "npm run check",
    "deploy": "wrangler deploy",
    "deploy:safe": "npm run check && wrangler deploy",
    "deploy:history": "wrangler deployments list",
    "deploy:rollback": "wrangler rollback",
    "deploy:rollback:latest": "wrangler rollback --message \"Rollback to previous stable version\"",
    "cf-typegen": "wrangler types",
    "migrate:local": "wrangler d1 migrations apply vn_market_news --local",
    "migrate:remote": "wrangler d1 migrations apply vn_market_news --remote",
    "ci:lighthouse": "lhci autorun --config=.lighthouserc.json",
    "ci:a11y": "pa11y-ci --config .pa11yci.json"
  },
  "dependencies": {
    "fast-xml-parser": "^4.5.0",
    "hono": "^4.6.10",
    "web-bot-auth": "^0.1.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260415.0",
    "@lhci/cli": "^0.15.1",
    "pa11y-ci": "^4.0.1",
    "typescript": "^5.8.3",
    "wrangler": "^4.13.2"
  }
}
